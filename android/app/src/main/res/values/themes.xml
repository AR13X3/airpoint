<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app draws everything in Compose; this only sets the window before first frame. -->
    <style name="Theme.Airpoint" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Airpoint.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Airpoint</item>
    </style>
</resources>
